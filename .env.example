# Google Gemini API key — get one for free at https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza...

# Postgres connection strings — get these from Supabase or Neon
# DATABASE_URL: pooled connection (used at runtime, serverless-safe)
# DIRECT_URL: direct connection (used only for running migrations)
DATABASE_URL=postgresql://user:password@host:5432/dbname?pgbouncer=true
DIRECT_URL=postgresql://user:password@host:5432/dbname

# Optional — add when you wire up auth (Clerk, Auth.js, etc.)
# NEXTAUTH_SECRET=
# CLERK_SECRET_KEY=
